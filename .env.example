# ==============================================================================
# MeowRoBot Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# Do NOT commit your real .env file with private credentials to version control!
# ==============================================================================

# [REQUIRED] Core Telegram Bot Credentials
# Get TOKEN from @BotFather on Telegram
TOKEN=

# Telegram API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Telegram User ID of the bot owner (numeric integer, e.g. 123456789)
OWNER_ID=

# [REQUIRED] Databases
# MongoDB Connection URI (e.g., from mongodb+srv://... or mongodb://mongo:27017/meowbot)
MONGO_DB_URI=mongodb://localhost:27017/meowbot

# Relational Database URL (PostgreSQL or SQLite)
# Examples:
#   PostgreSQL: postgresql://username:password@localhost:5432/meowbot
#   SQLite: sqlite:///sqldb.db
DATABASE_URL=sqlite:///sqldb.db

# [OPTIONAL] AI Chatbot Integration
CHATBOT_API_URL=https://chatbot.riteshyt.in/api/chat
CHATBOT_API_KEY=

# [OPTIONAL] Logging & Auditing
# Telegram Channel ID (with -100 prefix) to log system events, errors, bans
EVENT_LOGS=

# [OPTIONAL] Support & Community Channels
SUPPORT_CHAT=TeamAashik
SUPPORT_CHANNEL=AashikTeam

# [OPTIONAL] External APIs
# Currency converter API key from https://www.alphavantage.co/support/#api-key
CASH_API_KEY=
# Timezone API key from https://timezonedb.com/api
TIME_API_KEY=

# [OPTIONAL] Privileged User Tiers (space-separated numeric IDs)
# DRAGONS = Sudo Users | DEV_USERS = Developers | DEMONS = Support Staff
DRAGONS=
DEV_USERS=
DEMONS=
TIGERS=
WOLVES=

# [OPTIONAL] Bot Customizations
START_IMG=https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800
STRICT_GBAN=True
ALLOW_CHATS=True
DEL_CMDS=True
INFOPIC=True
WORKERS=8
